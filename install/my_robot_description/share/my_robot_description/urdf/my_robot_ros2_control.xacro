<?xml version ="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">
   
    <ros2_control type="system" name="RobotSystem">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
  
 
        <joint name="base_wheel_left_joint" >
            <command_interface name="velocity">
                <param name="min">-1</param>
                <param name="max">1</param>
            </command_interface>
            <!--this is the command which send to the motor (in simulator) 
            and have limits min = -1 rad/sec max = 1 rad/ sec-->

            <state_interface name="position"/>
            <state_interface name="velocity"/>
            
        </joint>

        <joint name="base_wheel_right_joint" >
            <command_interface name="velocity">
                <param name="min">-1</param>
                <param name="max">1</param>
            </command_interface>
            <!--this is the command which send to the motor (in simulator) 
            and have limits min = -1 rad/sec max = 1 rad/ sec-->

            <state_interface name="position"/>
            <state_interface name="velocity"/>
            
        </joint>
    </ros2_control>

</robot>
