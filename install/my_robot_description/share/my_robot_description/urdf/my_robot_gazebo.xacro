<?xml version ="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">
    
    <transmission name="right_wheel_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="right_wheel_motor" role = "actuator_right"/>
        <joint name="base_wheel_right_joint" role = "joint_right">
            <mechanicalReduction>1.0</mechanicalReduction>
        </joint>
        
    </transmission>


    <transmission name="left_wheel_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="left_wheel_motor" role = "actuator_left"/>
        <joint name="base_wheel_left_joint" role = "joint_left">
            <mechanicalReduction>1.0</mechanicalReduction>
        </joint>
        
    </transmission>




    <gazebo reference = "right_wheel_link">

        <mu1>100000000000000.0</mu1><!--(coef of friction)it is set to extremly haigh number to avoid any slipping-->
        <mu2>100000000000000.0</mu2><!--it is set to extremly haigh number to avoid any slipping-->
        <kp>1000000000000.0</kp><!--gazebo plugin-->
        <kd>10.0</kd>
        <minDepth>0.001</minDepth><!--solver accuracy-->
        <maxVel>0.1</maxVel> 
        <fdir1>1 0 0</fdir1>
    </gazebo>
    
        
    <gazebo reference = "left_wheel_link">

        <mu1>100000000000000.0</mu1><!--(coef of friction)it is set to extremly haigh number to avoid any slipping-->
        <mu2>100000000000000.0</mu2><!--it is set to extremly haigh number to avoid any slipping-->
        <kp>1000000000000.0</kp><!--gazebo plugin-->
        <kd>10.0</kd>
        <minDepth>0.001</minDepth><!--solver accuracy-->
        <maxVel>0.1</maxVel> 
        <fdir1>1 0 0</fdir1>


    </gazebo>
    
    <gazebo reference = "caster_wheel_rear"> 

        <mu1>0.1</mu1><!--(coef of friction)it is set to extremly haigh number to avoid any slipping-->
        <mu2>0.1</mu2><!--it is set to extremly haigh number to avoid any slipping-->
        <kp>1000000.0</kp><!--gazebo plugin-->
        <kd>100.0</kd>
        <minDepth>0.001</minDepth><!--solver accuracy-->
        <maxVel>0.1</maxVel> 
    </gazebo> 

    <gazebo reference = "caster_wheel_front">

        <mu1>0.1</mu1><!--(coef of friction)it is set to extremly haigh number to avoid any slipping-->
        <mu2>0.1</mu2><!--it is set to extremly haigh number to avoid any slipping-->
        <kp>1000000.0</kp><!--gazebo plugin-->
        <kd>100.0</kd>
        <minDepth>0.001</minDepth><!--solver accuracy-->
        <maxVel>0.1</maxVel> 
    </gazebo> 


    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find my_robot_controller)/config/my_robot_controller.yaml</parameters>
        </plugin>
    </gazebo>
</robot>